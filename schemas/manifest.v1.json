{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/44334433/memory-anchor/schemas/manifest.v1.json",
  "title": "StateManifest v1",
  "description": "Compaction-before snapshot: rules/todos/decisions/progress + recovery pointers. Verbatim text contract — items must never be paraphrased by summarizers.",
  "type": "object",
  "required": ["schema_version", "session_id", "created_at", "intent"],
  "properties": {
    "schema_version": { "const": 1 },
    "session_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "intent": { "type": "string" },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "text"],
        "properties": {
          "rule_id": { "type": "string" },
          "text": { "type": "string" },
          "source": { "type": "string" },
          "priority": { "type": "integer", "minimum": 0 },
          "immutable": { "type": "boolean" }
        }
      }
    },
    "todos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["todo_id", "title"],
        "properties": {
          "todo_id": { "type": "string" },
          "title": { "type": "string" },
          "status": { "enum": ["pending", "in_progress", "done", "blocked"] },
          "next_action": { "type": "string" },
          "depends_on": { "type": "array", "items": { "type": "string" } },
          "pointer": { "type": "string" }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["decision_id", "title", "decision"],
        "properties": {
          "decision_id": { "type": "string" },
          "title": { "type": "string" },
          "decision": { "type": "string" },
          "rationale": { "type": "string" },
          "source": { "type": "string" },
          "evidence": { "type": "string" },
          "status": { "enum": ["made", "tentative", "superseded"] },
          "timestamp": { "type": "string" }
        }
      }
    },
    "progress": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step"],
        "properties": {
          "step": { "type": "string" },
          "artifacts": { "type": "array", "items": { "type": "string" } },
          "pending_verification": { "type": "array", "items": { "type": "string" } },
          "breadcrumbs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "recovery_pointers": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
